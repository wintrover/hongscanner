<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app is a read-only client of the local API (127.0.0.1 via
         adb reverse / emulator alias). The default Flutter template ships
         INTERNET only in the debug/profile manifests; release needs it
         explicitly or every API call fails in a signed build. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Notification permission (Android 13+). firebase_messaging merges
         this transitively; declaring it keeps the permission flow the
         app implements (requestPermission + ask history) explicit. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="hongscanner"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FID-based FCM registration (firebase_messaging 17.x register()/
             onRegistered) is opt-in on Android: without this flag register()
             throws IllegalStateException and no FID events are delivered.
             https://firebase.google.com/docs/cloud-messaging/android/get-started -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Default notification channel for FCM background/terminated
             display: notification payloads without an explicit
             android.notification.channel_id post here, and the dispatcher
             (tools/notify) names this channel explicitly too. MainActivity
             creates "market_rank_changes" (IMPORTANCE_HIGH: sound, heads-up)
             at startup — until the app has run once, FCM falls back to its
             own low-importance channel (no sound, no heads-up). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="market_rank_changes" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
